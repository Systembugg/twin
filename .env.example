# Twin Enterprise Environment Variables Template
# Copy this to .env on your server and replace with your private keys

# AI Gateway Config (aicredits.in / OpenRouter / Groq / OpenAI)
TWIN_API_KEY=your_twin_api_key_here
TWIN_BASE_URL=https://aicredits.in/v1
TWIN_MODEL=deepseek/deepseek-v4-flash-0731
TWIN_ANALYSIS_MODEL=deepseek/deepseek-v4-flash-0731
TWIN_MODEL_PRICE=0.10,0.20

# Search API
TAVILY_API_KEY=your_tavily_api_key_here

# Sandbox & Workspaces
TWIN_SANDBOX_BACKEND=docker
TWIN_WORKSPACE_ROOT=/tmp/twin-workspaces

# RAG Vector Store (Qdrant)
TWIN_VECTOR_STORE=qdrant
TWIN_QDRANT_URL=your_qdrant_url_here
TWIN_QDRANT_API_KEY=your_qdrant_api_key_here

# Redis Rate Limiting Quotas (aicredits.in Tiers)
TWIN_USER_TOKENS_PER_HOUR=5000000
TWIN_USER_RUNS_PER_MINUTE=60
TWIN_USER_RUNS_PER_HOUR=3600
TWIN_USER_MAX_CONCURRENT=5
